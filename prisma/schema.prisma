// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────
enum AccountType {
  INVESTMENT
  SAVINGS
  EXPENSES
  CHARITY
}

enum ExpenseType {
  FIXED
  VARIABLE
}

enum NecessityType {
  ESSENTIAL
  LUXURY
}

enum FrequencyType {
  MONTHLY
  ONE_TIME
}

enum TransactionType {
  CREDIT // إضافة للرصيد
  DEBIT // خصم من الرصيد
}

enum Currency {
  EGP
  USD
  EUR
  // يمكن إضافة المزيد لاحقاً
}

enum LimitType {
  FIXED // مبلغ ثابت (مثال: 2000 جنيه)
  PERCENTAGE // نسبة مئوية (مثال: 20% من حساب النفقات)
}

// ─── BETTER-AUTH MODELS ──────────────────────────────────────────
model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dodoCustomerId String?

  sessions Session[]
  accounts Account[] // BetterAuth Provider Accounts

  // ─── MIZANI APP RELATIONS ───
  financialAccounts FinancialAccount[]
  categories        Category[]
  incomes           Income[]
  expenses          Expense[]
  goals             Goal[]
  budgets           Budget[]
  notifications     Notification[]
  budgetSetting     BudgetSetting?
  subscription      Subscription?
  userPreference    UserPreference?
  recurringExpenses RecurringExpense[]
  settingsHistories SettingsHistory[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─── MIZANI CORE MODELS ──────────────────────────────────────────

model FinancialAccount {
  id             String      @id @default(cuid())
  userId         String
  type           AccountType
  balance        Decimal     @default(0) @db.Decimal(12, 2)
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)
  targetPct      Decimal     @default(0) @db.Decimal(5, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  currency       Currency    @default(EGP)
  version        Int         @default(0)

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations       Allocation[]
  transactions      TransactionLedger[]
  goals             Goal[]
  recurringExpenses RecurringExpense[]
  expenses          Expense[]

  @@unique([userId, type])
  @@index([userId])
  @@map("financial_accounts")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String   @default("📦")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isArchived Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Income {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  source    String
  date      DateTime @db.Date // تخزين التاريخ فقط بدون الوقت المعقد إذا لم يلزم
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  @@index([userId, date]) // Index for fast monthly reports
  @@map("incomes")
}

model Allocation {
  id                 String    @id @default(cuid())
  incomeId           String
  financialAccountId String
  amount             Decimal   @db.Decimal(12, 2)
  percentage         Decimal   @db.Decimal(5, 2)
  deletedAt          DateTime?

  income           Income           @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([incomeId])
  @@index([financialAccountId])
  @@map("allocations")
}

model Expense {
  id          String        @id @default(cuid())
  userId      String
  title       String
  amount      Decimal       @db.Decimal(12, 2)
  categoryId  String
  date        DateTime      @db.Date
  expenseType ExpenseType
  necessity   NecessityType
  frequency   FrequencyType
  isRecurring Boolean       @default(false)
  parentId    String? // Self-relation reference if needed later
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  deletedAt          DateTime?
  financialAccountId String
  recurringExpenseId String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount  @relation(fields: [financialAccountId], references: [id])

  @@index([userId, date]) // Composite index for dashboard/reports
  @@index([userId, categoryId])
  @@map("expenses")
}

// Immutable Ledger - Event Sourcing concept for financial integrity
model TransactionLedger {
  id                 String          @id @default(cuid())
  financialAccountId String
  amount             Decimal         @db.Decimal(12, 2)
  type               TransactionType
  refType            String // "income" | "expense" | "manual" | "initial_balance"
  refId              String?
  note               String?
  createdAt          DateTime        @default(now())
  balanceAfter       Decimal         @db.Decimal(12, 2)
  currency           Currency        @default(EGP)

  idempotencyKey String? @unique

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([financialAccountId, createdAt(sort: Desc)]) // Optimized for unified transaction log UI
  @@map("transaction_ledgers")
}

model Goal {
  id                 String    @id @default(cuid())
  userId             String
  financialAccountId String // يرتبط عادة بحساب الادخار
  title              String
  targetAmount       Decimal   @db.Decimal(12, 2)
  currentAmount      Decimal   @default(0) @db.Decimal(12, 2)
  deadline           DateTime? @db.Date
  isCompleted        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  version Int @default(0)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
  @@map("goals")
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  categoryId String // تم الربط بالمعرف الفريد للفئة
  limit      Decimal   @db.Decimal(12, 2)
  limitType  LimitType @default(FIXED)
  month      Int       @db.SmallInt
  year       Int       @db.SmallInt
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year]) // منع وجود ميزانيتين لنفس الفئة في نفس الشهر
  @@map("budgets")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "budget_alert" | "recurring" | "goal" | "monthly_summary"
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model BudgetSetting {
  id            String   @id @default(cuid())
  userId        String   @unique
  investmentPct Decimal  @default(20) @db.Decimal(5, 2)
  savingsPct    Decimal  @default(20) @db.Decimal(5, 2)
  expensesPct   Decimal  @default(50) @db.Decimal(5, 2)
  charityPct    Decimal  @default(10) @db.Decimal(5, 2)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budget_settings")
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String    @default("free")
  status           String    @default("active")
  paymobOrderId    String?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  theme               String   @default("light")
  notifRecurring      Boolean  @default(true)
  notifBudgetAlert    Boolean  @default(true)
  notifMonthlySummary Boolean  @default(true)
  notifGoal           Boolean  @default(true)
  notifTime           String   @default("09:00")
  expoPushToken       String?
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// 1. دعم أتمتة النفقات المتكررة (Automation)
// 1. القالب الخاص بالعمليات التلقائية

model RecurringExpense {
  id         String  @id @default(cuid())
  userId     String
  title      String
  amount     Decimal @db.Decimal(12, 2)
  categoryId String

  // الحساب المالي الذي سيتم الخصم منه تلقائياً (جديد)
  financialAccountId String

  interval    FrequencyType // MONTHLY, WEEKLY
  startDate   DateTime
  nextRunDate DateTime // التاريخ القادم للتنفيذ
  lastRunDate DateTime? // تاريخ آخر مرة نجح فيها الخصم
  isActive    Boolean       @default(true)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category         @relation(fields: [categoryId], references: [id])
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  expenses         Expense[]

  @@index([nextRunDate, isActive])
  @@map("recurring_expenses")
}

// 2. سجل تتبع التغييرات في النسب المالية
model SettingsHistory {
  id     String @id @default(cuid())
  userId String

  // تخزين الحقول التي تغيرت (مثلاً: {"savingsPct": [20, 25]})
  // نستخدم JSON لمرونة تخزين أي تغييرات مستقبلية
  changeLog Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("settings_history")
}
